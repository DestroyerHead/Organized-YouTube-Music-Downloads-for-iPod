{
  "manifest_version": 3,
  "name": "Organized YouTube Music Downloads for iPod",
  "short_name": "→ iPod",
  "version": "1.1.0",
  "description": "Botão \"→ iPod\" no YouTube e no YouTube Music: manda músicas e playlists pro programa Organized YouTube Music Downloads for iPod.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icones/16.png", "48": "icones/48.png", "128": "icones/128.png" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["pagina.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["conteudo.js"],
      "css": ["estilo.css"],
      "run_at": "document_idle"
    }
  ]
}
